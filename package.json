{
  "name": "c5",
  "version": "0.1.0",
  "private": true,
  "description": "Category Five — chaotic Mario Party-style games",
  "homepage": "https://mapzimus.github.io/c5/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "crests": "python3 scripts/fetch-crests.py",
    "build:android": "tsc --noEmit && vite build --base=./",
    "android:sync": "npm run build:android && cap sync android",
    "android:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-apk.ps1"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@types/matter-js": "^0.20.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "flag-icons": "^7.5.0",
    "matter-js": "^0.19.0"
  }
}
